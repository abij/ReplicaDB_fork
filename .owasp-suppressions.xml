<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        jetty-http 9.4.58 pulled transitively by hadoop-common 3.5.0.
        Jetty 9.4.x is EOL; no patch exists in that line. Risk accepted:
        Hadoop's embedded Jetty server is not exposed by ReplicaDB.
    -->
    <suppress>
        <notes>Jetty 9.4.x EOL - transitive from hadoop-common, not exposed</notes>
        <gav regex="true">^org\.eclipse\.jetty:.*$</gav>
        <cvssBelow>10</cvssBelow>
    </suppress>

</suppressions>
